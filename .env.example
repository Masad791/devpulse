# Copy to .env.local. Every variable is optional: with none set, DevPulse fetches its sources live.

# Postgres for history, search, trends, click counts, release radar and rate limiting.
# Local: `npm run db:up` starts this exact database in Docker. Production: a hosted Postgres such as Neon
# (use its *pooled* connection string).
DATABASE_URL=postgres://devpulse:devpulse@localhost:54329/devpulse

# Protects /api/cron/ingest, and salts the IP hashes used for rate limiting. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# Recommended in production. Raises GitHub search from 10 to 30 requests/min for the
# Repos and Contribute pages and the "Rising repos" sidebar.
# Create a fine-grained token at https://github.com/settings/personal-access-tokens
# with "Public repositories (read-only)" access and no extra permissions.
GITHUB_TOKEN=

# Fills "Trending skills" on /skills (skills.sh API). On Vercel the ingest job gets it from the request once
# OIDC is on. For a local run, copy the line from `npx vercel env pull .env.vercel`; it lasts about 12 hours.
# VERCEL_OIDC_TOKEN=

# Absolute site URL for RSS/share images when not on Vercel (Vercel sets this up automatically).
# SITE_URL=https://devpulse.example.com
